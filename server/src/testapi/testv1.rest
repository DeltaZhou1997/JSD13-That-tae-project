  "tags": ["ภาคเหนือ", "ธาตุน้ำ", "สูตรดั้งเดิม"]
}

### 2.7 ทดสอบลบสินค้าออกจากคลัง
DELETE {{baseUrl}}/products/dish_002
Accept: application/json


### ===================================================================
### 3. หมวดหมู่ตะกร้าสินค้า (Cart Management)
### ===================================================================

### 3.1 ดึงรายการสินค้าในตะกร้าของผู้ใช้ (GET /cart/:userId)
GET {{baseUrl}}/cart/{{userId}}
Accept: application/json

### 3.2 เพิ่ม Cooking Kit เข้าตะกร้า (POST /cart/items)
POST {{baseUrl}}/cart/items
Content-Type: application/json

{
  "userId": "{{userId}}",
  "productId": "dish_001",
  "quantity": 2
}

### 3.3 เพิ่มสินค้าชิ้นที่สองเข้าตะกร้า
POST {{baseUrl}}/cart/items
Content-Type: application/json

{
  "userId": "{{userId}}",
  "productId": "dish_003",
  "quantity": 1
}

### 3.4 ปรับเปลี่ยนจำนวนสินค้าในตะกร้า (PUT /cart/items/:itemId)
PUT {{baseUrl}}/cart/items/dish_001
Content-Type: application/json

{
  "userId": "{{userId}}",
  "quantity": 3
}

### 3.5 ลบสินค้า 1 ชนิดออกจากตะกร้า
DELETE {{baseUrl}}/cart/items/dish_003
Content-Type: application/json

{
  "userId": "{{userId}}"
}

### 3.6 ล้างตะกร้าสินค้าทั้งหมด
DELETE {{baseUrl}}/cart/{{userId}}/clear
Accept: application/json


### ===================================================================
### 4. หมวดหมู่สั่งซื้อและคำสั่งซื้อ (Checkout & Orders)
### ===================================================================

### 4.1 สั่งซื้อสินค้า ตัดสต็อก และสร้าง Order (POST /checkout)
# @name checkoutRequest
POST {{baseUrl}}/checkout
Content-Type: application/json

{
  "userId": "{{userId}}",
  "items": [
    {
      "productId": "dish_001",
      "productName": "ข้าวซอยไก่สูตรเข้มข้น",
      "price": 189,
      "quantity": 2
    },
    {
      "productId": "dish_004",
      "productName": "แกงส้มชะอมกุ้งสด",
      "price": 220,
      "quantity": 1
    }
  ],
  "planType": "SINGLE_KIT",
  "shippingAddress": {
    "fullName": "สมชาย ใจดี",
    "phone": "0812345678",
    "address": "123/45 ถนนสุขุมวิท ซอย 21",
