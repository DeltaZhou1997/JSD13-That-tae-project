### ============================================================
### เครื่องมือ Admin — คำนวณสูตรอาหาร (Recipe Builder)
### ============================================================

## คำนวณธาตุและโภชนาการ โดยส่งแค่ ingredientId + กรัม
POST {{baseUrl}}/api/v1/admin/calculate-recipe
Content-Type: application/json

{
  "servings": 2,
  "items": [
    { "ingredientId": "ing_021", "quantity": 200 },
    { "ingredientId": "ing_052", "quantity": 80 },
    { "ingredientId": "ing_053", "quantity": 20 }
  ]
}

###

## คำนวณโดยไม่ส่ง items (คาดหวัง 400)
POST {{baseUrl}}/api/v1/admin/calculate-recipe
Content-Type: application/json

{ "items": [] }
