PORT=3001
MONGO_URI=
MONGODB_URI=
CLIENT_URL=
JWT_SECRET=
STRIPE_SECRET_KEY=
# ---- That-Tae Advisor (RAG / Gemini) ----
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
GEMINI_HTTP_TIMEOUT_MS=15000
# ขนาดเวกเตอร์ 768 / 1536 / 3072 (เปลี่ยนแล้วต้องรัน npm run advisor:index -- --force)
ADVISOR_EMBEDDING_DIM=768
# ชื่อ Atlas Vector Search index (เว้นว่าง = คำนวณ cosine ใน server เหมาะกับข้อมูลหลักร้อยรายการ)
ADVISOR_VECTOR_INDEX=
ADVISOR_SYNC_MINUTES=10
ADVISOR_TOP_K=8
ADVISOR_MIN_SCORE=0.45
ADVISOR_RATE_LIMIT_PER_MINUTE=12
ADVISOR_DAILY_LIMIT_PER_USER=100
ADVISOR_DAILY_LIMIT_GLOBAL=3000
